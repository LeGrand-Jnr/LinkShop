rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validName(value) {
      return value is string && value.size() > 0 && value.size() <= 100;
    }

    function isShopOwner(shopId) {
      return signedIn()
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'role'])
        && request.resource.data.role == 'owner'
        && validName(request.resource.data.name)
        && request.resource.data.email is string;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data.name);
      allow delete: if false;
    }

    match /shops/{shopId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerId', 'shopName', 'slug', 'description', 'logo'])
        && validName(request.resource.data.shopName)
        && request.resource.data.slug is string
        && request.resource.data.slug.size() >= 3
        && request.resource.data.slug.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.logo is string;
      allow update: if isShopOwner(shopId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.keys().hasOnly(['ownerId', 'shopName', 'slug', 'description', 'logo'])
        && validName(request.resource.data.shopName)
        && request.resource.data.slug is string
        && request.resource.data.description is string;
      allow delete: if isShopOwner(shopId);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['shopId', 'name', 'price', 'image', 'stock'])
        && isShopOwner(request.resource.data.shopId)
        && validName(request.resource.data.name)
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.image is string;
      allow update: if signedIn()
        && resource.data.shopId is string
        && isShopOwner(resource.data.shopId)
        && request.resource.data.shopId == resource.data.shopId
        && request.resource.data.keys().hasOnly(['shopId', 'name', 'price', 'image', 'stock'])
        && validName(request.resource.data.name)
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0;
      allow delete: if signedIn()
        && resource.data.shopId is string
        && isShopOwner(resource.data.shopId);
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && exists(/databases/$(database)/documents/shops/$(resource.data.shopId))
        && get(/databases/$(database)/documents/shops/$(resource.data.shopId)).data.ownerId == request.auth.uid;

      // Orders must be submitted through the Cloud Function so totals,
      // prices, stock, server timestamps, and abuse controls are trusted.
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
